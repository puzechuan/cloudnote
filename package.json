{
  "name": "cloudnote",
  "version": "1.0.0",
  "private": true,
  "description": "cloudnote - 基于 Cloudflare Workers + D1 的在线记事本",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/wrangler.mjs dev",
    "deploy": "node scripts/wrangler.mjs deploy",
    "check": "node scripts/wrangler.mjs deploy --dry-run",
    "db:create": "node scripts/wrangler.mjs d1 create cloudnote-db",
    "db:init": "node scripts/wrangler.mjs d1 execute DB --remote --yes --file=init_cloudnote_db.sql",
    "db:init:local": "node scripts/wrangler.mjs d1 execute DB --local --yes --file=init_cloudnote_db.sql",
    "wrangler": "node scripts/wrangler.mjs",
    "test": "node --experimental-sqlite test/worker.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.164.0"
  }
}
